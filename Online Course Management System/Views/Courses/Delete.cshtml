@model Online_Course_Management_System.Models.Course

<h1>Delete Course</h1>

<h3>Are you sure you want to delete this course?</h3>

<div>
    <p>
        <strong>Name:</strong>
        @Model.Name
    </p>

    <p>
        <strong>Description:</strong>
        @Model.Description
    </p>

    <p>
        <strong>Price:</strong>
        @Model.Price
    </p>

    <p>
        <strong>Duration:</strong>
        @Model.Duration hours
    </p>

    <p>
        <strong>Category:</strong>
        @Model.Category.Name
    </p>

    <p>
        <strong>Instructor:</strong>
        @Model.Instructor.Name
    </p>
</div>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit">
        Confirm Delete
    </button>

    <a asp-action="Index">
        Cancel
    </a>

</form>